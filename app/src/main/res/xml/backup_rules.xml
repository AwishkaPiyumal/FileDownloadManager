<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
    <!-- Exclude databases containing download history/URLs to protect privacy -->
    <exclude domain="database" path="."
        tools:ignore="FullBackupContent" />
    <!-- Exclude downloaded cache files and temporary folders -->
    <exclude domain="external" path="."
        tools:ignore="FullBackupContent" />
    <exclude domain="root" path="no_backup"
        tools:ignore="FullBackupContent" />
    
    <!-- Only backup user preferences -->
    <include domain="sharedpref" path="." />
</full-backup-content>
