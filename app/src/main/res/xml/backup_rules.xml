<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude databases containing download history/URLs to protect privacy -->
    <exclude domain="database" path="." />
    <!-- Exclude downloaded cache files and temporary folders -->
    <exclude domain="external" path="." />
    <exclude domain="root" path="no_backup" />
    
    <!-- Only backup user preferences -->
    <include domain="sharedpref" path="." />
</full-backup-content>
